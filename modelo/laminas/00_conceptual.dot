digraph "00_conceptual" {
graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=22, fontcolor="#173847", pad="0.4", nodesep="0.45", ranksep="0.85", splines=polyline, concentrate=false, outputorder=edgesfirst, labelloc=t, labeljust=l, label="SIGD  |  Vista conceptual del negocio\lModelo entidad-relación conceptual\l"];
node [fontname="Arial", fontsize=11, color="#90A9B7"];
edge [fontname="Arial", fontsize=9, color="#78929F", fontcolor="#254657", arrowsize=0.65, penwidth=1.05, dir=both, arrowtail=tee, arrowhead=crow];
"users" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Usuario"];
"teachers" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Docente"];
"campuses" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Campus"];
"careers" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Carrera"];
"periods" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Periodo académico"];
"catalog_versions" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Versión de catálogo"];
"documents" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Documento docente"];
"work_plans" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Plan de trabajo"];
"activity_reports" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Informe de actividades"];
"document_versions" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Versión inmutable"];
"reviews" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Revisión de versión"];
"document_sections" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Sección del documento"];
"activity_records" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Registro de actividad"];
"evidence" [shape=box, style="rounded,filled", margin=".2,.16", fillcolor="#F1F6F8", label="Evidencia"];
"users" -> "teachers" [id="rel1", taillabel="1", headlabel="0..1", label="tiene perfil", labeldistance=1.7, labelangle=0, arrowhead=tee, tooltip="users.id → teachers.user_id"];
"campuses" -> "careers" [id="rel2", taillabel="1", headlabel="0..N", label="pertenece a", labeldistance=1.7, labelangle=0, arrowhead=crow, tooltip="campuses.id → careers.campus_id"];
