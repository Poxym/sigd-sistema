digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.1, pad=0.4, fontname="Arial", bgcolor="#FFFFFF", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="24" COLOR="#13242E"><B>SIGD · Versionado y revisión</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#55656F">5 tablas del dominio (detalle completo) · en gris, tablas de otros dominios a las que se hace referencia</FONT><BR ALIGN="LEFT"/> >];
  node [shape=plaintext, fontname="Arial", margin=0];
  edge [fontname="Arial"];
  "document_versions" [label=<<TABLE BORDER="1" COLOR="#2D4F8F" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#2D4F8F" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>document_versions</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Versión inmutable</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="document_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>document_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="document_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="number_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">number</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">integer</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="number_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="event_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">event</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="event_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="actor_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>actor_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="actor_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="at_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="content_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">content</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">jsonb</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="content_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="digest_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">digest</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="digest_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F3F5F6" CELLPADDING="4"><FONT POINT-SIZE="8.5" COLOR="#55656F">UQ* (document_id, number)</FONT></TD></TR></TABLE>>];
  "reviews" [label=<<TABLE BORDER="1" COLOR="#2D4F8F" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#2D4F8F" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>reviews</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Revisión de versión</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="document_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>document_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="document_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="version_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>version_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="version_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="reviewer_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>reviewer_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="reviewer_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="result_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">result</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="result_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="comment_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">comment</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="comment_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="at_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
  "review_visits" [label=<<TABLE BORDER="1" COLOR="#2D4F8F" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#2D4F8F" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>review_visits</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Sección revisada</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="version_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>version_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="version_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="reviewer_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>reviewer_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="reviewer_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="section_key_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">section_key</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="section_key_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="at_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F3F5F6" CELLPADDING="4"><FONT POINT-SIZE="8.5" COLOR="#55656F">UQ* (version_id, reviewer_id, section_key)</FONT></TD></TR></TABLE>>];
  "observations" [label=<<TABLE BORDER="1" COLOR="#2D4F8F" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#2D4F8F" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>observations</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Observación</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="review_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>review_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="review_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="section_key_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">section_key</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="section_key_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="record_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>record_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="record_id_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="text_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">text</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="text_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="resolved_at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">resolved_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="resolved_at_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR></TABLE>>];
  "idempotency_keys" [label=<<TABLE BORDER="1" COLOR="#2D4F8F" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#2D4F8F" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>idempotency_keys</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Solicitud idempotente</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="actor_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>actor_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="actor_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="request_key_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">request_key</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="request_key_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="request_hash_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">request_hash</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="request_hash_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="response_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">response</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">jsonb</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="response_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="created_at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">created_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="created_at_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F3F5F6" CELLPADDING="4"><FONT POINT-SIZE="8.5" COLOR="#55656F">UQ* (actor_id, request_key)</FONT></TD></TR></TABLE>>];
  "documents" [label=<<TABLE BORDER="1" COLOR="#B7C0C6" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F7F8F9"><TR><TD COLSPAN="4" BGCOLOR="#9AA5AD" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>documents</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Documento docente · Plan de trabajo, informe y evidencias</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
  "users" [label=<<TABLE BORDER="1" COLOR="#B7C0C6" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F7F8F9"><TR><TD COLSPAN="4" BGCOLOR="#9AA5AD" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>users</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Usuario · Identidad docente</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
  "activity_records" [label=<<TABLE BORDER="1" COLOR="#B7C0C6" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F7F8F9"><TR><TD COLSPAN="4" BGCOLOR="#9AA5AD" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>activity_records</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Registro de actividad · Plan de trabajo, informe y evidencias</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
  "documents":id_e:e -> "document_versions":document_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="document_versions.document_id → documents.id"];
  "users":id_e:e -> "document_versions":actor_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="document_versions.actor_id → users.id"];
  "documents":id_e:e -> "reviews":document_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="reviews.document_id → documents.id"];
  "document_versions":id_e:e -> "reviews":version_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="reviews.version_id → document_versions.id"];
  "users":id_e:e -> "reviews":reviewer_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="reviews.reviewer_id → users.id"];
  "document_versions":id_e:e -> "review_visits":version_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="review_visits.version_id → document_versions.id"];
  "users":id_e:e -> "review_visits":reviewer_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="review_visits.reviewer_id → users.id"];
  "reviews":id_e:e -> "observations":review_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="observations.review_id → reviews.id"];
  "activity_records":id_e:e -> "observations":record_id_w:w [dir=both, arrowtail=teeodot, arrowhead=crowodot, style=dashed, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="observations.record_id → activity_records.id"];
  "users":id_e:e -> "idempotency_keys":actor_id_w:w [dir=both, arrowtail=teetee, arrowhead=crowodot, style=solid, color="#4A5B66", penwidth=1.3, arrowsize=0.9, tooltip="idempotency_keys.actor_id → users.id"];
}
