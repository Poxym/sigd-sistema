digraph G {
  graph [rankdir=LR, pack=30, packmode="array_2", splines=spline, nodesep=0.45, ranksep=1.1, pad=0.4, fontname="Arial", bgcolor="#FFFFFF", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="24" COLOR="#13242E"><B>SIGD · Modelo relacional general</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#55656F">58 tablas · 90 claves foráneas · vista de claves (PK/FK) agrupada por dominio</FONT><BR ALIGN="LEFT"/> >];
  node [shape=plaintext, fontname="Arial", margin=0];
  edge [fontname="Arial"];
  subgraph "cluster_Estructura" { label=<<FONT POINT-SIZE="16" COLOR="#1F5F7A"><B>Estructura académica</B></FONT>>; style="rounded,filled"; color="#1F5F7A"; fillcolor="#E8F1F5"; penwidth=1.5; margin=18;
    "universities" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>universities</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Universidad</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="8.5" COLOR="#8A979F">+ 1 atributos</FONT></TD></TR></TABLE>>];
    "campuses" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>campuses</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Campus</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="university_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>university_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="university_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="8.5" COLOR="#8A979F">+ 3 atributos</FONT></TD></TR></TABLE>>];
    "careers" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>careers</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Carrera</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="campus_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>campus_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="campus_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="predecessor_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>predecessor_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="predecessor_id_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="8.5" COLOR="#8A979F">+ 3 atributos</FONT></TD></TR></TABLE>>];
    "study_plans" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>study_plans</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Plan de estudio</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="career_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>career_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="career_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="created_by_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>created_by</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="created_by_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="8.5" COLOR="#8A979F">+ 4 atributos</FONT></TD></TR></TABLE>>];
    "curriculum_semesters" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>curriculum_semesters</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Semestre del plan</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="study_plan_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>study_plan_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="study_plan_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="8.5" COLOR="#8A979F">+ 1 atributos</FONT></TD></TR></TABLE>>];
    "subjects" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>subjects</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Materia</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="8.5" COLOR="#8A979F">+ 4 atributos</FONT></TD></TR></TABLE>>];
    "curriculum_subjects" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>curriculum_subjects</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Asignatura del plan</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="semester_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>semester_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="semester_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="subject_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>subject_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="subject_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
