digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.1, pad=0.4, fontname="Arial", bgcolor="#FFFFFF", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="24" COLOR="#13242E"><B>SIGD · Estructura académica</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#55656F">12 tablas del dominio (detalle completo) · en gris, tablas de otros dominios a las que se hace referencia</FONT><BR ALIGN="LEFT"/> >];
  node [shape=plaintext, fontname="Arial", margin=0];
  edge [fontname="Arial"];
  "universities" [label=<<TABLE BORDER="1" COLOR="#1F5F7A" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#1F5F7A" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>universities</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Universidad</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="name_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="name_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
