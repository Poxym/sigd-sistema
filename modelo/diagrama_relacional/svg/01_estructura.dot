NT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">boolean</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="active_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
