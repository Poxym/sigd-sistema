digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.1, pad=0.4, fontname="Arial", bgcolor="#FFFFFF", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="24" COLOR="#13242E"><B>SIGD · Identidad docente</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#55656F">7 tablas del dominio (detalle completo) · en gris, tablas de otros dominios a las que se hace referencia</FONT><BR ALIGN="LEFT"/> >];
