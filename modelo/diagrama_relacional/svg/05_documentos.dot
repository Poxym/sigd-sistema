digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.1, pad=0.4, fontname="Arial", bgcolor="#FFFFFF", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="24" COLOR="#13242E"><B>SIGD · Plan de trabajo, informe y evidencias</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#55656F">10 tablas del dominio (detalle completo) · en gris, tablas de otros dominios a las que se hace referencia</FONT><BR ALIGN="LEFT"/> >];
  node [shape=plaintext, fontname="Arial", margin=0];
  edge [fontname="Arial"];
  "projects" [label=<<TABLE BORDER="1" COLOR="#9A5B12" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#9A5B12" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>projects</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Proyecto</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="code_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">code</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="code_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="name_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="name_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="funding_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">funding</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="funding_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="start_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">start</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">date</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="start_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="end_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">end</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">date</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="end_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR></TABLE>>];
  "documents" [label=<<TABLE BORDER="1" COLOR="#9A5B12" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#9A5B12" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>documents</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Documento docente</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="teacher_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>teacher_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="teacher_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="period_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>period_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="period_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="career_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>career_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="career_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="catalog_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>catalog_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="catalog_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="kind_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">kind</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="kind_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="state_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">state</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="state_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="version_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">version</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">integer</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="version_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="revision_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">revision</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">integer</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="revision_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="created_at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">created_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="created_at_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="updated_at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">updated_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="updated_at_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="submitted_at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">submitted_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="submitted_at_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="approved_at_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">approved_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">timestamptz</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="approved_at_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="content_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">content</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">jsonb</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="content_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F3F5F6" CELLPADDING="4"><FONT POINT-SIZE="8.5" COLOR="#55656F">UQ* (teacher_id, period_id, kind)</FONT></TD></TR></TABLE>>];
