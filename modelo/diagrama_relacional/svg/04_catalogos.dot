digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.1, pad=0.4, fontname="Arial", bgcolor="#FFFFFF", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="24" COLOR="#13242E"><B>SIGD · Catálogos configurables por periodo</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#55656F">12 tablas del dominio (detalle completo) · en gris, tablas de otros dominios a las que se hace referencia</FONT><BR ALIGN="LEFT"/> >];
  node [shape=plaintext, fontname="Arial", margin=0];
  edge [fontname="Arial"];
  "rubrics" [label=<<TABLE BORDER="1" COLOR="#6B4E9B" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#6B4E9B" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>rubrics</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Rubro académico</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="code_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">code</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="code_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="name_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="name_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="axis_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">axis</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="axis_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="active_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">active</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">boolean</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="active_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
  "activities" [label=<<TABLE BORDER="1" COLOR="#6B4E9B" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#6B4E9B" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>activities</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Actividad académica</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="code_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">code</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="code_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="name_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="name_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="active_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">active</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">boolean</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="active_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR></TABLE>>];
  "activity_classifications" [label=<<TABLE BORDER="1" COLOR="#6B4E9B" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#6B4E9B" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>activity_classifications</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Clasificación vigente</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="activity_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>activity_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="activity_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="rubric_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>rubric_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="rubric_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="start_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">start</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">date</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="start_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="end_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">end</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">date</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="end_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR></TABLE>>];
  "field_definitions" [label=<<TABLE BORDER="1" COLOR="#6B4E9B" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#6B4E9B" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>field_definitions</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Definición de campo</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="activity_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>activity_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="activity_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="key_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">key</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="key_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="label_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">label</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="label_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="type_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">type</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="type_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="required_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">required</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">boolean</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="required_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="position_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">position</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">integer</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="position_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="constraints_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">constraints</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">jsonb</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="constraints_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="comparison_key_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">comparison_key</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="comparison_key_e"><FONT POINT-SIZE="8" COLOR="#A0ACB3">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F3F5F6" CELLPADDING="4"><FONT POINT-SIZE="8.5" COLOR="#55656F">UQ* (activity_id, key)</FONT></TD></TR></TABLE>>];
  "field_options" [label=<<TABLE BORDER="1" COLOR="#6B4E9B" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="4" BGCOLOR="#6B4E9B" CELLPADDING="6" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>field_options</B></FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="9">Opción de campo</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="id_w"><FONT COLOR="#B8860B" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><B><U>id</U></B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="field_id_w"><FONT COLOR="#3D6E91" POINT-SIZE="9"><B>FK</B></FONT> <FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33"><I>field_id</I></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="field_id_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="value_w"><FONT COLOR="#6B7C86" POINT-SIZE="9"><B>UQ*</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">value</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="value_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="label_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">label</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">text</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="label_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3" PORT="position_w"> </TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11" COLOR="#1D2B33">position</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#55656F">integer</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="3" PORT="position_e"><FONT POINT-SIZE="8" COLOR="#55656F">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F3F5F6" CELLPADDING="4"><FONT POINT-SIZE="8.5" COLOR="#55656F">UQ* (field_id, value)</FONT></TD></TR></TABLE>>];
